{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cdimurro/quantity-and-quality/main/data/quantity_quality_record.schema.json",
  "title": "Quantity + Quality Energy Record",
  "description": "A machine-readable record for reporting energy quantity together with Exergy Factor.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["energy", "power"]
    },
    "quantity": {
      "type": "number",
      "minimum": 0
    },
    "power": {
      "type": "number",
      "minimum": 0
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "string",
      "enum": ["F0", "F1", "F2", "F3", "F4"]
    },
    "fidelity_tier": {
      "type": "string",
      "enum": ["F0", "F1", "F2", "F3", "F4"]
    },
    "fx": {
      "type": "number",
      "minimum": 0
    },
    "exergy_factor": {
      "type": "number",
      "minimum": 0
    },
    "notation": {
      "type": "string"
    },
    "full_notation": {
      "type": "string"
    },
    "accessible_exergy": {
      "type": "number",
      "minimum": 0
    },
    "accessible_exergy_unit": {
      "type": "string"
    },
    "accessible_exergy_rate": {
      "type": "number",
      "minimum": 0
    },
    "accessible_exergy_rate_unit": {
      "type": "string"
    },
    "accessible_exergy_mwh": {
      "type": "number",
      "minimum": 0
    },
    "accessible_exergy_mw": {
      "type": "number",
      "minimum": 0
    },
    "distinguishability": {
      "type": "object",
      "required": ["status", "distinguishable", "basis", "evidence", "exergy_factor"],
      "properties": {
        "schema_version": {"type": "string"},
        "status": {
          "type": "string",
          "enum": ["distinguishable", "indistinguishable"]
        },
        "distinguishable": {"type": "boolean"},
        "basis": {"type": "string"},
        "evidence": {"type": "string"},
        "exergy_factor": {"type": "number", "minimum": 0},
        "factor_role": {"type": "string"},
        "source_state": {"type": "object"},
        "reference_state": {"type": "object"},
        "difference": {"type": "object"}
      }
    },
    "reference_id": {
      "type": "string"
    },
    "reference": {
      "oneOf": [{"type": "string"}, {"type": "object"}]
    },
    "boundary": {
      "type": "string"
    },
    "basis": {
      "type": "string"
    },
    "operating_basis": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "method_id": {
      "type": "string"
    },
    "stream_type": {
      "type": "string",
      "enum": ["electricity", "mechanical", "electromagnetic_field", "heat", "cooling", "fluid", "humid_air", "fuel", "solar", "radiation", "separation", "nuclear", "plasma", "dissipation", "custom"]
    },
    "quantity_method_id": {
      "type": "string"
    },
    "calculation_inputs": {
      "type": "object"
    },
    "stream_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "interval": {
      "type": "string"
    },
    "interval_start": {
      "type": "string"
    },
    "interval_end": {
      "type": "string"
    },
    "source_c": {
      "type": "number"
    },
    "return_c": {
      "type": "number"
    },
    "sink_c": {
      "type": "number"
    },
    "cold_service_c": {
      "type": "number"
    },
    "ambient_sink_c": {
      "type": "number"
    },
    "fuel": {
      "type": "string"
    },
    "chemical_exergy": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "energy_basis": {
      "type": "string"
    },
    "energy_basis_value": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Numeric energy denominator used with chemical_exergy. HHV/LHV labels belong in energy_basis."
    },
    "carrier_registry_version": {
      "type": "string"
    },
    "uncertainty": {
      "oneOf": [{"type": "number", "minimum": 0}, {"type": "object"}]
    },
    "data_quality_flag": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "readiness": {
      "type": "object"
    },
    "source": {
      "type": "object"
    },
    "issues": {
      "type": "array",
      "items": {"type": "object"}
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conformance_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs_attention": {
      "type": "boolean"
    }
  },
  "anyOf": [
    {
      "required": ["notation"]
    },
    {
      "allOf": [
        {
          "required": ["unit"]
        },
        {
          "anyOf": [
            {"required": ["quantity"]},
            {"required": ["power"]}
          ]
        },
        {
          "anyOf": [
            {"required": ["fx"]},
            {"required": ["exergy_factor"]},
            {"required": ["reference_id"]},
            {"required": ["source_c", "sink_c"]},
            {"required": ["cold_service_c", "ambient_sink_c"]},
            {"required": ["chemical_exergy", "energy_basis_value"]},
            {"required": ["tier"], "properties": {"tier": {"const": "F0"}}},
            {"required": ["fidelity_tier"], "properties": {"fidelity_tier": {"const": "F0"}}}
          ]
        }
      ]
    }
  ]
}
