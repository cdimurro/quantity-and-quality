# Superseded paper drafts and LaTeX build artifacts stay out of the repository.
# The canonical source, reproducibility scripts, generated tables, figures, and
# public PDF are explicitly retained below so the published analysis is auditable.
paper/*
!paper/quantity-and-quality-standard-reporting-framework.pdf
!paper/Quantity_and_Quality_Third_Draft.tex
!paper/Makefile
!paper/README.md
!paper/generated/
!paper/generated/*.csv
!paper/ece_comparison.pdf
!paper/f3_district_heat_backcast.pdf
!paper/reference_temp_sensitivity.pdf
!paper/theta_loss_mapping.pdf
scripts/*
!scripts/sync_reference_data.py
!scripts/analyze_xai4heat.py
!scripts/generate_paper_figures.py
nul
